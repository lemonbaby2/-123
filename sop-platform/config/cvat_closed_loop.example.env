# Keep runtime data outside the source tree in production.
SOP_RUNTIME_DIR=/srv/sop/runtime

# CVAT API access. Store the real token in a root-readable environment file.
CVAT_API_URL=http://localhost:8081
CVAT_PUBLIC_URL=http://192.168.1.129:8081
CVAT_TOKEN=replace-with-cvat-personal-token

# Configure the same secret in the CVAT Webhook and the SOP backend.
SOP_CVAT_WEBHOOK_SECRET=replace-with-random-webhook-secret
SOP_CVAT_WEBHOOK_PULL_EVENTS=update:job,update:task

# Resource limits for annotation-only synchronization.
SOP_CVAT_SYNC_CONCURRENCY=2
SOP_CVAT_MAX_ANNOTATION_BYTES=268435456
